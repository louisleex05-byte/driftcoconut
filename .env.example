# === Agoda (required for live data) ===
# Get these from https://partners.agoda.com after signing up
AGODA_SITE_ID=your_site_id_here
AGODA_API_KEY=your_api_key_here

# === Mock mode — use while waiting for Agoda approval ===
# Set to "true" to serve sample hotel data instead of hitting the real API
AGODA_MOCK=true

# === Domain verification meta tags (paste value only, no HTML) ===
# NEXT_PUBLIC_AGODA_VERIFICATION=
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# === Optional: Expedia Rapid API (apply at partner.expediagroup.com) ===
# EXPEDIA_API_KEY=
# EXPEDIA_SHARED_SECRET=

# === Site ===
# Canonical URL (used for meta tags, sitemap, absolute link generation)
NEXT_PUBLIC_SITE_URL=https://driftcoconut.com

# === Agoda (required for live data) ===
# Get these from https://partners.agoda.com after signing up
AGODA_SITE_ID=your_site_id_here
AGODA_API_KEY=your_api_key_here

# === Mock mode — use while waiting for Agoda approval ===
# Set to "true" to serve sample hotel data instead of hitting the real API
AGODA_MOCK=true

# === Domain verification meta tags (paste value only, no HTML) ===
# NEXT_PUBLIC_AGODA_VERIFICATION=
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# === Optional: Booking.com (via Awin or direct Partner Hub) ===
# BOOKING_AFFILIATE_ID=

# === Optional: Expedia (via Partnerize — apply at signup.partnerize.com/signup/en/expedia) ===
# EXPEDIA_API_KEY=
# EXPEDIA_SHARED_SECRET=

# === Optional: Tripadvisor (via CJ Affiliate) ===
# TRIPADVISOR_CJ_ID=

# === Optional: Travelpayouts Drive script ===
# Full URL from Travelpayouts install page. Loaded via next/script.
# Comment out or leave empty to disable.
# NEXT_PUBLIC_TRAVELPAYOUTS_SRC=https://emrld.ltd/NTYxMTY4.js?t=561168
